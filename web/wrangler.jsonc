{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "byaan-web",
  "compatibility_date": "2024-10-26",
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/share/*", "/n/*"]
  }
}
