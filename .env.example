DB_PASSWORD=your-secure-password

# Frontend URL
FRONTEND_URL=http://localhost:17434

# Data Workshop OpenConnector control plane (server-side only)
OPENCONNECTOR_URL=https://openconnector.example.internal
OPENCONNECTOR_PUBLIC_URL=https://openconnector.example.com
OPENCONNECTOR_ADMIN_TOKEN=replace-with-secret-manager-reference
# Short-lived OAuth/JWT for the approved read-only test identity; server-side only.
OPENCONNECTOR_TEST_RUNTIME_TOKEN=replace-with-controlled-user-token
# Defaults to REAL. TEST must only be set by isolated automated test harnesses.
DATA_WORKSHOP_BACKEND_MODE=REAL

# Port overrides (defaults shown, change if ports are busy)
# DB_PORT=5432
# BACKEND_PORT=17433
# FRONTEND_PORT=17434
# W5 AgentKit settings are server-only. Never expose these as VITE_* variables.
W5_SKILL_AGENT_RUNTIME_ID=
W5_SKILL_AGENT_ENDPOINT=
W5_SKILL_AGENT_API_KEY=
W5_SKILL_AGENT_REGION=cn-beijing
AGENTKIT_CLI_PATH=agentkit
W5_DELEGATED_AUTH_PROVIDER=
W6_RESOURCE_REF_PROVIDER=
# Optional comma-separated HTTPS hosts allowed for Artifact ZIP proxying.
W5_ARTIFACT_HOSTS=
W5_ARTIFACT_BEARER_TOKEN=

# DWV1 cloud OIDC. The browser receives only the opaque session cookie.
DWV1_EXTERNAL_OIDC_ENABLED=false
DWV1_OIDC_PUBLIC_ORIGIN=https://data-studio.example.com
DWV1_OIDC_ISSUER=https://identity.example.com
DWV1_OIDC_AUDIENCE=data-studio
DWV1_OIDC_USER_POOL=f69c17b4-d030-43bc-b4a7-9cae0f6370c3
DWV1_OIDC_CLIENT_ID=
DWV1_OIDC_GROUPS_CLAIM=groups
DWV1_OIDC_REQUIRED_GROUP=
DWV1_RUNTIME_SECRET_NAME=dwv1/data-studio/dev
DWV1_SKILL_AGENT_SECRET_NAME=dwv1/skill-agent/dev
# Non-secret Delegation Broker binding; must match the verified UserPool.
I4A_DELEGATION_ISSUER=https://identity.example.com
I4A_DELEGATION_USER_POOL=f69c17b4-d030-43bc-b4a7-9cae0f6370c3
I4A_DELEGATION_AUDIENCE=dwv1-skill-agent
I4A_DELEGATION_GROUP_UID=
# JSON KMS field used as the application and profile-store DATABASE_URL.
OPENVIKING_PROFILE_DATABASE=
OPENVIKING_MANAGED_BASE_URL=
DWV1_DATABASE_SCHEMA=data_studio
# JSON KMS fields: data_studio_oauth_client_secret, broker_service_credential,
# openconnector_admin_token, openviking_api_key, openviking_profile_key,
# database_url, w5_runtime_api_key, app_secret.
DWV1_ALLOW_ENV_SECRETS=false
